{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to QEMU (gdb-multiarch)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/kernel8.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "gdb-multiarch",
            "MIMode": "gdb",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load kernel symbols at physical address (for early boot)",
                    "text": "add-symbol-file ${workspaceFolder}/build/kernel8.elf 0x40080000",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Start QEMU Debug"
        }
    ]
}
